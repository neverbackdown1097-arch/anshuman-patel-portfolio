# Copy to .env.local for local testing; set the same keys in your host for production.

# Public URL of the live site (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=

# Contact form — configure ONE option.
# Option A: Resend
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Option B: Formspree
FORMSPREE_ENDPOINT=
